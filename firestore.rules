rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {

        function signedIn() {
            return request.auth != null;
        }

        function isAdmin() {
            return signedIn()
                && get(
                    /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.role == "admin";
        }

        match /users/{userId} {

            allow create:
                if signedIn()
                && request.auth.uid == userId
                && request.resource.data.role == "user";

            allow read:
                if signedIn()
                && (
                    request.auth.uid == userId
                    || isAdmin()
                );

            allow update:
                if signedIn()
                && request.auth.uid == userId
                && request.resource.data.role ==
                   resource.data.role;

            allow delete:
                if isAdmin();
        }

        match /users/{userId}/workoutHistory/{workoutId} {

            allow read, create, update:
                if signedIn()
                && (
                    request.auth.uid == userId
                    || isAdmin()
                );

            allow delete:
                if signedIn()
                && (
                    request.auth.uid == userId
                    || isAdmin()
                );
        }

        match /users/{userId}/aiPlans/{planId} {

            allow read, create, update:
                if signedIn()
                && (
                    request.auth.uid == userId
                    || isAdmin()
                );

            allow delete:
                if signedIn()
                && (
                    request.auth.uid == userId
                    || isAdmin()
                );
        }

        match /{document=**} {
            allow read, write: if false;
        }
    }
}
