package com.homeworkout.app.view

import androidx.compose.foundation.background
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.shape.CircleShape
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.Button
import androidx.compose.material3.ButtonDefaults
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Brush
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp

@Composable
fun OnboardingScreen(
    onGetStarted: () -> Unit,
    onLogin: () -> Unit
) {
    val background = Color(0xFFF7FAF8)
    val navy = Color(0xFF172033)
    val green = Color(0xFF2FA36B)
    val greenDark = Color(0xFF218255)
    val greenSoft = Color(0xFFE8F6EF)
    val muted = Color(0xFF687386)
    val border = Color(0xFFE3E8E5)

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(background)
    ) {

        Box(
            modifier = Modifier
                .size(260.dp)
                .align(Alignment.TopEnd)
                .offset(
                    x = 85.dp,
                    y = (-70).dp
                )
                .background(
                    Brush.radialGradient(
                        listOf(
                            green.copy(alpha = 0.16f),
                            Color.Transparent
                        )
                    )
                )
        )

        Column(
            modifier = Modifier
                .fillMaxSize()
                .statusBarsPadding()
                .navigationBarsPadding()
                .padding(
                    horizontal = 22.dp,
                    vertical = 18.dp
                ),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {

            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically
            ) {

                LogoMark()

                Spacer(
                    modifier = Modifier.width(10.dp)
                )

                Column(
                    modifier = Modifier.weight(1f)
                ) {

                    Row(
                        verticalAlignment = Alignment.CenterVertically
                    ) {

                        Text(
                            text = "Home",
                            color = navy,
                            fontSize = 19.sp,
                            fontWeight = FontWeight.ExtraBold
                        )

                        Text(
                            text = "Workout",
                            color = greenDark,
                            fontSize = 19.sp,
                            fontWeight = FontWeight.ExtraBold
                        )
                    }

                    Text(
                        text = "YOUR DAILY TRAINING COMPANION",
                        color = muted,
                        fontSize = 7.sp,
                        fontWeight = FontWeight.Bold,
                        letterSpacing = 0.8.sp
                    )
                }

                SurfacePill(
                    text = "01 / 03",
                    color = greenSoft,
                    textColor = greenDark
                )
            }

            Spacer(
                modifier = Modifier.height(28.dp)
            )

            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(285.dp)
                    .clip(
                        RoundedCornerShape(30.dp)
                    )
                    .background(
                        Brush.linearGradient(
                            listOf(
                                Color(0xFFE8F7EF),
                                Color(0xFFF2FBF6)
                            )
                        )
                    )
            ) {

                Box(
                    modifier = Modifier
                        .size(210.dp)
                        .align(Alignment.TopEnd)
                        .offset(
                            x = 55.dp,
                            y = (-30).dp
                        )
                        .background(
                            Brush.radialGradient(
                                listOf(
                                    green.copy(alpha = 0.18f),
                                    Color.Transparent
                                )
                            )
                        )
                )

                Column(
                    modifier = Modifier
                        .fillMaxSize()
                        .padding(24.dp),
                    verticalArrangement = Arrangement.SpaceBetween
                ) {

                    SurfacePill(
                        text = "MOVE • TRAIN • GROW",
                        color = Color.White.copy(alpha = 0.78f),
                        textColor = greenDark
                    )

                    FitnessGraphic()
                }
            }

            Spacer(
                modifier = Modifier.height(28.dp)
            )

            Text(
                text = "Your Fitness Journey",
                color = navy,
                fontSize = 28.sp,
                lineHeight = 32.sp,
                fontWeight = FontWeight.ExtraBold
            )

            Text(
                text = "Starts Here.",
                color = greenDark,
                fontSize = 28.sp,
                lineHeight = 32.sp,
                fontWeight = FontWeight.ExtraBold
            )

            Spacer(
                modifier = Modifier.height(13.dp)
            )

            Text(
                text = "Get personalized workout plans,",
                color = muted,
                fontSize = 13.sp
            )

            Text(
                text = "track your progress and build",
                color = muted,
                fontSize = 13.sp
            )

            Text(
                text = "better training habits every day.",
                color = muted,
                fontSize = 13.sp
            )

            Spacer(
                modifier = Modifier.height(21.dp)
            )

            Row(
                horizontalArrangement = Arrangement.spacedBy(7.dp)
            ) {

                PageDot(
                    selected = true,
                    green = green,
                    border = border
                )

                PageDot(
                    selected = false,
                    green = green,
                    border = border
                )

                PageDot(
                    selected = false,
                    green = green,
                    border = border
                )
            }

            Spacer(
                modifier = Modifier.weight(1f)
            )

            Button(
                onClick = onGetStarted,
                modifier = Modifier
                    .fillMaxWidth()
                    .height(56.dp),
                shape = RoundedCornerShape(18.dp),
                colors = ButtonDefaults.buttonColors(
                    containerColor = green,
                    contentColor = Color.White
                )
            ) {

                Text(
                    text = "Get Started",
                    fontSize = 15.sp,
                    fontWeight = FontWeight.ExtraBold
                )
            }

            Spacer(
                modifier = Modifier.height(13.dp)
            )

            Row(
                verticalAlignment = Alignment.CenterVertically
            ) {

                Text(
                    text = "Already have an account?",
                    color = muted,
                    fontSize = 11.sp
                )

                Spacer(
                    modifier = Modifier.width(5.dp)
                )

                Text(
                    text = "Login",
                    color = greenDark,
                    fontSize = 11.sp,
                    fontWeight = FontWeight.ExtraBold,
                    modifier = Modifier.clickable(onClick = onLogin)
                )
            }

            Spacer(
                modifier = Modifier.height(13.dp)
            )
        }
    }
}

@Composable
private fun LogoMark() {

    Row(
        modifier = Modifier
            .width(42.dp)
            .height(42.dp)
            .clip(
                RoundedCornerShape(13.dp)
            )
            .background(
                Color(0xFFE8F6EF)
            ),
        horizontalArrangement = Arrangement.Center,
        verticalAlignment = Alignment.CenterVertically
    ) {

        Bar(
            width = 5.dp,
            height = 19.dp
        )

        Spacer(
            modifier = Modifier.width(2.dp)
        )

        Bar(
            width = 4.dp,
            height = 14.dp,
            light = true
        )

        Spacer(
            modifier = Modifier.width(3.dp)
        )

        Bar(
            width = 17.dp,
            height = 4.dp
        )

        Spacer(
            modifier = Modifier.width(3.dp)
        )

        Bar(
            width = 4.dp,
            height = 14.dp,
            light = true
        )

        Spacer(
            modifier = Modifier.width(2.dp)
        )

        Bar(
            width = 5.dp,
            height = 19.dp
        )
    }
}

@Composable
private fun Bar(
    width: androidx.compose.ui.unit.Dp,
    height: androidx.compose.ui.unit.Dp,
    light: Boolean = false
) {

    Box(
        modifier = Modifier
            .width(width)
            .height(height)
            .clip(
                RoundedCornerShape(50.dp)
            )
            .background(
                if (light) {
                    Color(0xFF9FE3D0)
                } else {
                    Color(0xFF2FA36B)
                }
            )
    )
}

@Composable
private fun SurfacePill(
    text: String,
    color: Color,
    textColor: Color
) {

    Box(
        modifier = Modifier
            .clip(
                RoundedCornerShape(50.dp)
            )
            .background(color)
            .padding(
                horizontal = 10.dp,
                vertical = 6.dp
            )
    ) {

        Text(
            text = text,
            color = textColor,
            fontSize = 7.sp,
            fontWeight = FontWeight.ExtraBold,
            letterSpacing = 0.7.sp
        )
    }
}

@Composable
private fun FitnessGraphic() {

    Box(
        modifier = Modifier.fillMaxSize()
    ) {

        Box(
            modifier = Modifier
                .size(135.dp)
                .align(Alignment.Center)
                .clip(CircleShape)
                .background(
                    Color.White.copy(alpha = 0.72f)
                )
        )

        Box(
            modifier = Modifier
                .width(9.dp)
                .height(68.dp)
                .align(Alignment.Center)
                .offset(y = 5.dp)
                .clip(RoundedCornerShape(50.dp))
                .background(Color(0xFF172033))
        )

        Box(
            modifier = Modifier
                .width(62.dp)
                .height(9.dp)
                .align(Alignment.Center)
                .offset(y = (-4).dp)
                .clip(RoundedCornerShape(50.dp))
                .background(Color(0xFF2FA36B))
        )

        Box(
            modifier = Modifier
                .size(24.dp)
                .align(Alignment.Center)
                .offset(y = (-47).dp)
                .clip(CircleShape)
                .background(Color(0xFF172033))
        )

        Box(
            modifier = Modifier
                .width(70.dp)
                .height(8.dp)
                .align(Alignment.Center)
                .offset(x = (-31).dp, y = 55.dp)
                .clip(RoundedCornerShape(50.dp))
                .background(Color(0xFF172033))
        )

        Box(
            modifier = Modifier
                .width(70.dp)
                .height(8.dp)
                .align(Alignment.Center)
                .offset(x = 31.dp, y = 55.dp)
                .clip(RoundedCornerShape(50.dp))
                .background(Color(0xFF172033))
        )
    }
}

@Composable
private fun PageDot(
    selected: Boolean,
    green: Color,
    border: Color
) {

    Box(
        modifier = Modifier
            .width(
                if (selected) {
                    24.dp
                } else {
                    8.dp
                }
            )
            .height(8.dp)
            .clip(CircleShape)
            .background(
                if (selected) {
                    green
                } else {
                    border
                }
            )
    )
}
