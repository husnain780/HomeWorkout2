    fun find(id: String): Exercise? {
        return exercises.firstOrNull { it.id == id }
    }

    fun imageRes(id: String): Int {
        return find(id)?.imageRes ?: R.drawable.push_up
    }

    fun categories(): List<String> {
        return listOf("All") + exercises.map { it.category }.distinct()
    }
}
